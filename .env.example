# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
# Qdrant server; docker-compose.yml runs one locally on this port.
QDRANT_URL=http://localhost:6333
# LangSmith tracing (row 6). Leave LANGSMITH_TRACING empty to run with tracing off.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neuro-rag
