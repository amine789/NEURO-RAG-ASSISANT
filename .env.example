# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
# Qdrant server; docker-compose.yml runs one locally on this port.
QDRANT_URL=http://localhost:6333
# Langfuse Cloud tracing (row 6). Leave the keys empty to run with tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENROUTER_API_KEY=your-openrouter-key-here
